# Sao chép thành deploy/.env trên VPS rồi điền. KHÔNG commit file .env.
#   cp deploy/.env.example deploy/.env && nano deploy/.env

# Tên miền trỏ về IP VPS (bản ghi A). Chưa có tên miền: dùng <IP-nối-bằng-gạch>.sslip.io
# VD IP 203.0.113.10 → 203-0-113-10.sslip.io
DOMAIN=demo.tencongty.vn

# Tạo chuỗi ngẫu nhiên: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# Tạo chuỗi ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=

# Bản demo cho khách: true = tạo tài khoản demo (mật khẩu Cardiy2026) khi chạy lệnh seed
SEED_DEMO=true
# Bản demo: false để khách thử nhanh. Bản chính thức: true (bắt buộc 2FA cho Chủ garage / Quản lý)
AUTH_ENFORCE_2FA=false

# Zalo OA (gửi tin ZNS: OTP, xác nhận lịch, báo giá, xe sửa xong, nhắc bảo dưỡng).
# Tuỳ chọn: có thể nhập App ID / Secret key ngay trong CRM (Cài đặt → Zalo), giá trị trong CRM được ưu tiên.
# Lấy ở developers.zalo.me → ứng dụng liên kết với OA. Refresh token của OA dán trong CRM: Cài đặt → Zalo.
ZALO_APP_ID=
ZALO_APP_SECRET=

# Lưu trữ hình ảnh & chứng từ trên Cloudflare R2 (tương thích S3).
# Mặc định để trống (local) sẽ lưu trên ổ đĩa VPS; đặt FILE_STORAGE=s3 để lưu thẳng lên Cloudflare R2.
FILE_STORAGE=s3
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=cardiy
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Tuỳ chọn: nếu gắn Custom Domain công khai cho bucket R2 (VD: https://img.tencongty.vn) thì điền vào đây; để trống hệ thống tự ký link Presigned URL an toàn.
S3_PUBLIC_URL=

