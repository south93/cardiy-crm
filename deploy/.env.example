# Sao chép thành deploy/.env trên VPS rồi điền. KHÔNG commit file .env.
#   cp deploy/.env.example deploy/.env && nano deploy/.env

# Tên miền trỏ về IP VPS (bản ghi A). Chưa có tên miền: dùng <IP-nối-bằng-gạch>.sslip.io
# VD IP 203.0.113.10 → 203-0-113-10.sslip.io
DOMAIN=demo.tencongty.vn

# Tạo chuỗi ngẫu nhiên: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# Tạo chuỗi ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=

# Bản demo cho khách: true = tạo tài khoản demo (mật khẩu Cardiy2026) khi chạy lệnh seed
SEED_DEMO=true
# Bản demo: false để khách thử nhanh. Bản chính thức: true (bắt buộc 2FA cho Chủ garage / Quản lý)
AUTH_ENFORCE_2FA=false

# Zalo OA (gửi tin ZNS: OTP, xác nhận lịch, báo giá, xe sửa xong, nhắc bảo dưỡng).
# Lấy ở developers.zalo.me → ứng dụng liên kết với OA → App ID và Khoá bí mật (Secret key).
# Refresh token của OA dán trong CRM: Cài đặt → Zalo. Để trống = chưa dùng Zalo.
ZALO_APP_ID=
ZALO_APP_SECRET=
