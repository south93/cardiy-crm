// Mô hình dữ liệu CARDIY. Đặc tả đầy đủ: docs/06-mo-hinh-du-lieu.md (nhóm D1)
// Vòng 0.1: tenants, branches. Vòng 0.2: users, memberships, roles, permissions,
// sessions, audit_logs, files.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// PLATFORM: sàn CARDIY · GARAGE: garage PLG dùng CRM · PARTNER: đối tác (chỉ cổng đối tác, 1 tài khoản)
enum TenantType {
  PLATFORM
  GARAGE
  PARTNER
}

/// Trạng thái đối tác theo máy trạng thái S4
enum TenantStatus {
  NHAP
  CHO_DUYET
  CAN_BO_SUNG
  TU_CHOI
  CHO_KY_HOP_DONG
  DANG_THIET_LAP
  HOAT_DONG
  TAM_KHOA
  CHAM_DUT
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum PermissionScope {
  PLATFORM
  TENANT
  PARTNER
}

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  type          TenantType   @default(GARAGE)
  name          String
  taxCode       String?      @unique @map("tax_code")
  status        TenantStatus @default(NHAP)
  /// Thông tin in trên phiếu (tên hiển thị, hotline, tài khoản nhận tiền, ghi chú bảo hành…)
  printSettings Json?        @map("print_settings")
  /// Mốc nhắc chăm sóc khách (số ngày): đăng kiểm, bảo hiểm, bảo dưỡng, hỏi thăm sau sửa
  careSettings  Json?        @map("care_settings")
  /// Gửi tin Zalo ZNS: bật/tắt, chế độ, mẫu tin từng sự kiện (vòng 2.3). Refresh token lưu riêng (mã hoá) ở zalo_tokens
  zaloSettings  Json?        @map("zalo_settings")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  branches    Branch[]
  memberships Membership[]
  roles       Role[]
  files       FileObject[]

  @@map("tenants")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  address   String?
  phone     String?
  lat       Float?
  lng       Float?
  bays      Int       @default(0)
  /// Vùng giá: BP = giá Bình Phước (giá bán chính), BD = giá Bình Dương
  priceZone String    @default("BP") @map("price_zone")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  membershipRoles MembershipRole[]
  orders          RepairOrder[]
  bookings        Booking[]
  stock           StockLevel[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

/// Tài khoản đăng nhập. Một người có thể làm việc ở nhiều tenant (qua Membership).
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  phone              String     @unique
  email              String?
  fullName           String     @map("full_name")
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  totpSecret         String?    @map("totp_secret")
  totpEnabled        Boolean    @default(false) @map("totp_enabled")
  avatarFileId       String?    @map("avatar_file_id") @db.Uuid
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  memberships   Membership[]
  sessions      Session[]
  customerLinks CustomerLink[]
  ownerSessions OwnerSession[]

  @@map("users")
}

/// Người dùng làm việc tại một tenant
model Membership {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  title     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user   User             @relation(fields: [userId], references: [id])
  tenant Tenant           @relation(fields: [tenantId], references: [id])
  roles  MembershipRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

/// Vai trò. tenantId = null: vai trò hệ thống (không sửa được).
model Role {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String?         @map("tenant_id") @db.Uuid
  code       String
  name       String
  scope      PermissionScope @default(TENANT)
  isSystem   Boolean         @default(false) @map("is_system")
  require2fa Boolean         @default(false) @map("require_2fa")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  members     MembershipRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  code  String          @id
  group String
  label String
  scope PermissionScope

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

/// Gán vai trò cho thành viên. branchId = null: áp dụng mọi chi nhánh.
model MembershipRole {
  id           String  @id @default(uuid()) @db.Uuid
  membershipId String  @map("membership_id") @db.Uuid
  roleId       String  @map("role_id") @db.Uuid
  branchId     String? @map("branch_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])

  @@unique([membershipId, roleId, branchId])
  @@index([membershipId])
  @@map("membership_roles")
}

/// Phiên đăng nhập: lưu băm của refresh token, xoay vòng mỗi lần làm mới.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ip           String?
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// Thu hồi do xoay vòng (làm mới phiên), khác với đăng xuất / khoá
  rotatedAt    DateTime? @map("rotated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Nhật ký thao tác: chỉ được thêm. Trigger trong migration chặn UPDATE/DELETE.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model FileObject {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  storageKey String   @unique @map("storage_key")
  mime       String
  size       Int
  name       String
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("files")
}

// ======================= Vòng 1.1: Khách hàng & Xe (D2) =======================

/// Bộ đếm sinh mã theo tenant (KH000001, RO000001…). Tăng nguyên tử bằng SQL.
model TenantCounter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("tenant_counters")
}

enum CustomerType {
  PERSON
  COMPANY
}

enum CustomerTier {
  THUONG
  BAC
  VANG
  KIM_CUONG
}

/// Nguồn khách theo danh mục đang dùng ở AppSheet của PLG
enum CustomerSource {
  ZALO
  FACEBOOK
  TIKTOK
  GIOI_THIEU
  KHACH_CU
  VANG_LAI
  WEBSITE
  CUOC_GOI
  GARA
  CHAM_SOC_XE
  DAI_LY
  SAN_CARDIY
  KHAC
}

model Customer {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  code             String
  type             CustomerType   @default(PERSON)
  name             String
  /// Số điện thoại chuẩn hoá 0xxxxxxxxx, không trùng trong một tenant.
  /// Có thể trống (khách vãng lai): khi đó nhận diện theo biển số xe.
  phone            String?
  phone2           String?
  email            String?
  address          String?
  taxCode          String?        @map("tax_code")
  representative   String?
  /// Chi nhánh phục vụ đầu tiên (khách dùng chung mọi chi nhánh)
  branchId         String?        @map("branch_id") @db.Uuid
  birthday         DateTime?      @db.Date
  tier             CustomerTier   @default(THUONG)
  source           CustomerSource @default(VANG_LAI)
  note             String?
  /// Khách đồng ý nhận tin chăm sóc / khuyến mại (Nghị định 13/2023)
  marketingConsent Boolean        @default(false) @map("marketing_consent")
  /// Công nợ ban đầu khi chuyển từ hệ thống cũ (VND)
  openingDebt      BigInt         @default(0) @map("opening_debt")
  importBatchId    String?        @map("import_batch_id") @db.Uuid
  searchText       String         @default("") @map("search_text")
  createdBy        String?        @map("created_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  ownerships VehicleOwnership[]
  orders     RepairOrder[]
  bookings   Booking[]
  careTasks  CareTask[]

  appLink    CustomerLink?
  appInvites CustomerInvite[]

  @@unique([tenantId, code])
  @@unique([tenantId, phone])
  @@index([tenantId, searchText])
  @@map("customers")
}

model Vehicle {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// Biển số chuẩn hoá (30A12345), không trùng trong một tenant
  plateNo            String    @map("plate_no")
  vin                String?
  make               String?
  model              String?
  year               Int?
  color              String?
  fuel               String?
  transmission       String?
  tireSize           String?   @map("tire_size")
  /// false: biển số chưa đúng mẫu (thiếu số…), cần xem lại
  plateValid         Boolean   @default(true) @map("plate_valid")
  importBatchId      String?   @map("import_batch_id") @db.Uuid
  odometerKm         Int?      @map("odometer_km")
  registrationExpiry DateTime? @map("registration_expiry") @db.Date
  insuranceExpiry    DateTime? @map("insurance_expiry") @db.Date
  note               String?
  searchText         String    @default("") @map("search_text")
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  ownerships VehicleOwnership[]
  odometers  OdometerReading[]
  orders     RepairOrder[]
  bookings   Booking[]

  @@unique([tenantId, plateNo])
  @@index([tenantId, searchText])
  @@map("vehicles")
}

/// Lịch sử chủ xe. toDate = null: chủ hiện tại (mỗi xe tối đa 1).
model VehicleOwnership {
  id         String    @id @default(uuid()) @db.Uuid
  vehicleId  String    @map("vehicle_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  fromDate   DateTime  @default(now()) @map("from_date")
  toDate     DateTime? @map("to_date")

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([vehicleId])
  @@index([customerId])
  @@map("vehicle_ownerships")
}

model OdometerReading {
  id         String   @id @default(uuid()) @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  km         Int
  /// MANUAL: nhập tay · IMPORT: nhập file · RO: lúc tiếp nhận xe (vòng 1.2)
  source     String   @default("MANUAL")
  recordedBy String?  @map("recorded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, createdAt])
  @@map("odometer_readings")
}

enum ImportKind {
  CUSTOMERS
  VEHICLES
  /// Danh mục sản phẩm + tồn đầu kỳ từ file Excel AppSheet (vòng 1.4c)
  PRODUCTS
}

enum ImportStatus {
  PREVIEW
  DONE
}

/// Một lần nhập dữ liệu (xem trước → xác nhận). plan: kết quả phân tích, xoá sau khi nhập xong.
model ImportBatch {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  kind        ImportKind
  status      ImportStatus @default(PREVIEW)
  fileName    String       @map("file_name")
  encoding    String
  summary     Json
  issues      Json
  plan        Json?
  createdBy   String       @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  committedAt DateTime?    @map("committed_at")

  @@index([tenantId, createdAt])
  @@map("import_batches")
}

// ---------------- Vòng 1.2 · Đơn hàng (lệnh sửa chữa / bán hàng) ----------------

/// Luồng cơ bản: TIEP_NHAN → DANG_SUA → HOAN_THANH → DA_GIAO; huỷ được khi chưa giao.
enum OrderStatus {
  TIEP_NHAN
  DANG_SUA
  HOAN_THANH
  DA_GIAO
  HUY
}

enum OrderItemKind {
  DICH_VU
  PHU_TUNG
}

enum PaymentMethod {
  TIEN_MAT
  CHUYEN_KHOAN
  THE
  /// Công ty bảo hiểm thanh toán phần của họ
  BAO_HIEM
}

model RepairOrder {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  /// DH000001… theo garage
  code            String
  customerId      String      @map("customer_id") @db.Uuid
  /// Bán lẻ phụ kiện thì có thể không có xe
  vehicleId       String?     @map("vehicle_id") @db.Uuid
  status          OrderStatus @default(TIEP_NHAN)
  odometerKm      Int?        @map("odometer_km")
  /// Khách yêu cầu / triệu chứng
  request         String?
  note            String?
  /// Người phụ trách (cố vấn dịch vụ) và kỹ thuật viên chính: membership id
  advisorId       String?     @map("advisor_id") @db.Uuid
  technicianId    String?     @map("technician_id") @db.Uuid
  /// Tiền: đồng, số nguyên
  subtotal        BigInt      @default(0)
  /// Giảm giá trên cả đơn (ngoài giảm từng dòng)
  orderDiscount   BigInt      @default(0) @map("order_discount")
  /// Tổng thuế VAT (theo % thuế từng dòng, sau chiết khấu)
  vatTotal        BigInt      @default(0) @map("vat_total")
  /// Trong tổng cộng: phần bảo hiểm thanh toán (khách trả phần còn lại)
  insuranceAmount BigInt      @default(0) @map("insurance_amount")
  total           BigInt      @default(0)
  paid            BigInt      @default(0)
  receivedAt      DateTime    @default(now()) @map("received_at")
  promisedAt      DateTime?   @map("promised_at")
  completedAt     DateTime?   @map("completed_at")
  deliveredAt     DateTime?   @map("delivered_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  cancelReason    String?     @map("cancel_reason")
  searchText      String      @default("") @map("search_text")
  createdBy       String?     @map("created_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  branch     Branch               @relation(fields: [branchId], references: [id])
  customer   Customer             @relation(fields: [customerId], references: [id])
  vehicle    Vehicle?             @relation(fields: [vehicleId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  history    OrderStatusHistory[]
  booking    Booking?
  inspection Inspection?
  quotes     OrderQuote[]
  review     OrderReview?

  @@unique([tenantId, code])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, branchId, status])
  @@index([customerId])
  @@index([vehicleId])
  @@map("repair_orders")
}

model OrderItem {
  id        String        @id @default(uuid()) @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  kind      OrderItemKind
  /// Gắn sản phẩm trong danh mục (vòng 1.4); trống = nhập tay
  productId String?       @map("product_id") @db.Uuid
  name      String
  unit      String?
  quantity  Decimal       @db.Decimal(12, 2)
  unitPrice BigInt        @map("unit_price")
  discount  BigInt        @default(0)
  amount    BigInt
  /// % thuế VAT của dòng (0, 5, 8, 10…)
  vatRate   Int           @default(0) @map("vat_rate")
  /// Phần trên phiếu (VD: Phần lốp, Phần gầm); trống = không chia phần
  section   String?
  sortOrder Int           @default(0) @map("sort_order")

  order   RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Garage thu tiền trực tiếp (tiền không đi qua sàn). Thu nhầm thì huỷ phiếu, không xoá.
model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  orderId    String        @map("order_id") @db.Uuid
  amount     BigInt
  method     PaymentMethod
  note       String?
  paidAt     DateTime      @default(now()) @map("paid_at")
  createdBy  String?       @map("created_by") @db.Uuid
  voidedAt   DateTime?     @map("voided_at")
  voidedBy   String?       @map("voided_by") @db.Uuid
  voidReason String?       @map("void_reason")

  order RepairOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([tenantId, paidAt])
  @@map("payments")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  actorId    String?      @map("actor_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  order RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------- Vòng 1.4 · Danh mục sản phẩm & kho ----------------

/// Nhóm sản phẩm 2 cấp (VD: Lốp xe → Lốp du lịch). Mỗi garage một bộ.
model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@index([tenantId, parentId])
  @@map("product_categories")
}

/// Hàng hoá (PHU_TUNG, có tồn kho) hoặc dịch vụ (DICH_VU, không tồn kho)
model Product {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  /// Mã hàng: tự sinh SP000001 hoặc nhập tay (mã cũ, mã vạch)
  code         String
  name         String
  kind         OrderItemKind @default(PHU_TUNG)
  categoryId   String?       @map("category_id") @db.Uuid
  /// Thương hiệu sản phẩm (Michelin, GS, Castrol…)
  brand        String?
  unit         String?
  salePrice    BigInt        @default(0) @map("sale_price")
  /// Giá vùng Bình Dương (chi nhánh vùng giá BD dùng giá này; trống thì dùng giá bán chính)
  salePriceBd  BigInt?       @map("sale_price_bd")
  /// Giá khi xuất hoá đơn VAT (tham khảo)
  vatPrice     BigInt?       @map("vat_price")
  /// Giá vốn: cập nhật theo lần nhập gần nhất
  costPrice    BigInt        @default(0) @map("cost_price")
  /// Hãng xe dùng được (rỗng = mọi hãng)
  vehicleMakes String[]      @default([]) @map("vehicle_makes")
  /// Tháng / năm sản xuất (lốp, ắc quy…); tháng có thể trống
  mfgMonth     Int?          @map("mfg_month")
  mfgYear      Int?          @map("mfg_year")
  /// Cảnh báo khi tồn tại một chi nhánh xuống dưới mức này
  minStock     Decimal?      @map("min_stock") @db.Decimal(12, 2)
  note         String?
  active       Boolean       @default(true)
  searchText   String        @default("") @map("search_text")
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  stock      StockLevel[]
  movements  StockMovement[]
  orderItems OrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId, categoryId])
  @@index([tenantId, searchText])
  @@map("products")
}

/// Tồn hiện tại của một sản phẩm tại một chi nhánh (cho phép âm: bán trước, nhập sau)
model StockLevel {
  productId String   @map("product_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@id([productId, branchId])
  @@index([branchId])
  @@map("stock_levels")
}

model Supplier {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  code           String
  name           String
  phone          String?
  address        String?
  taxCode        String?   @map("tax_code")
  note           String?
  /// Còn nợ nhà cung cấp lúc bắt đầu dùng hệ thống (đồng); công nợ = nợ đầu kỳ + phiếu nhập − phiếu chi trả NCC
  openingPayable BigInt    @default(0) @map("opening_payable")
  searchText     String    @default("") @map("search_text")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  documents StockDocument[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

enum StockDocType {
  NHAP
  CHUYEN
  DIEU_CHINH
}

/// Phiếu kho: nhập hàng (từ nhà cung cấp), chuyển kho giữa chi nhánh, điều chỉnh tồn (kiểm kê)
model StockDocument {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  /// PN000001 · PC000001 · PK000001
  code       String
  type       StockDocType
  branchId   String       @map("branch_id") @db.Uuid
  toBranchId String?      @map("to_branch_id") @db.Uuid
  supplierId String?      @map("supplier_id") @db.Uuid
  /// Số hoá đơn / chứng từ của nhà cung cấp
  refNo      String?      @map("ref_no")
  note       String?
  total      BigInt       @default(0)
  createdBy  String?      @map("created_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  supplier  Supplier?       @relation(fields: [supplierId], references: [id])
  movements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, type, createdAt])
  @@map("stock_documents")
}

enum StockMoveKind {
  NHAP_HANG
  XUAT_BAN
  CHUYEN_DI
  CHUYEN_DEN
  DIEU_CHINH
}

/// Sổ kho: mọi thay đổi tồn đều ghi một dòng (số lượng có dấu), không sửa / xoá
model StockMovement {
  id         String        @id @default(uuid()) @db.Uuid
  /// Thứ tự ghi sổ (các dòng cùng một giao dịch có cùng thời điểm)
  seq        BigInt        @unique @default(autoincrement())
  tenantId   String        @map("tenant_id") @db.Uuid
  branchId   String        @map("branch_id") @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  kind       StockMoveKind
  quantity   Decimal       @db.Decimal(12, 2)
  /// Tồn sau khi ghi (để xem lịch sử nhanh)
  balance    Decimal       @db.Decimal(12, 2)
  unitCost   BigInt?       @map("unit_cost")
  documentId String?       @map("document_id") @db.Uuid
  orderId    String?       @map("order_id") @db.Uuid
  note       String?
  createdBy  String?       @map("created_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")

  product  Product        @relation(fields: [productId], references: [id])
  document StockDocument? @relation(fields: [documentId], references: [id])

  @@index([productId, branchId, createdAt])
  @@index([tenantId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// ---------------- Vòng 1.5a · Lịch hẹn ----------------

/// Máy trạng thái S2 (docs/05-trang-thai.md)
enum BookingStatus {
  CHO_XAC_NHAN
  DA_XAC_NHAN
  DA_DEN
  KHONG_DEN
  KHACH_HUY
  TU_CHOI
}

enum BookingChannel {
  GOI_DIEN
  ZALO
  FACEBOOK
  TRUC_TIEP
  WEBSITE
  KHAC
  /// Khách tự đặt trên app chủ xe (vòng 2.2)
  APP
}

model Booking {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  branchId     String         @map("branch_id") @db.Uuid
  /// LH000001…
  code         String
  customerId   String         @map("customer_id") @db.Uuid
  vehicleId    String?        @map("vehicle_id") @db.Uuid
  scheduledAt  DateTime       @map("scheduled_at")
