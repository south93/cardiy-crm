  ZALO_ZNS
  SMS
}

enum CampaignStatus {
  NHAP
  DA_LEN_LICH
  HOAN_THANH
  HUY
}

enum CampaignDeliveryStatus {
  SENT
  SKIPPED_NO_CONSENT
  FAILED
}

/// Lịch sử đồng ý / rút lại đồng ý nhận tin của chủ xe (D1 · Nghị định 13/2023)
model Consent {
