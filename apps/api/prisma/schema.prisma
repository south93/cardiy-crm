// Mô hình dữ liệu CARDIY. Đặc tả đầy đủ: docs/06-mo-hinh-du-lieu.md
// Vòng 0.1 chỉ có tenant + chi nhánh để kiểm tra đường ống migration.
// Vòng 0.2 thêm users, memberships, roles, permissions, audit_logs.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  PLATFORM
  GARAGE
}

/// Trạng thái đối tác theo máy trạng thái S4
enum TenantStatus {
  NHAP
  CHO_DUYET
  CAN_BO_SUNG
  TU_CHOI
  CHO_KY_HOP_DONG
  DANG_THIET_LAP
  HOAT_DONG
  TAM_KHOA
  CHAM_DUT
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  type      TenantType   @default(GARAGE)
  name      String
  taxCode   String?      @unique @map("tax_code")
  status    TenantStatus @default(NHAP)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  branches Branch[]

  @@map("tenants")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  address   String?
  lat       Float?
  lng       Float?
  bays      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}
