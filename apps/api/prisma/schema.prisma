// ---------------- Vòng 1.5b · Lịch gọi chăm sóc khách ----------------

enum CareKind {
  DANG_KIEM
  BAO_HIEM
  BAO_DUONG
  HOI_THAM
  KHAC
}

enum CareStatus {
  /// Cần gọi (tới hạn hoặc sắp tới)
  CAN_GOI
  /// Khách hẹn gọi lại / không nghe máy: hạn gọi dời sang ngày khác
  GOI_LAI
  /// Xong (đã tư vấn, đã đặt lịch, khách không cần)
  XONG
  BO_QUA
}

enum CallOutcome {
  DA_TU_VAN
  DAT_LICH
  KHONG_NGHE
  GOI_LAI_SAU
  KHONG_CAN
  SAI_SO
}

/// Việc gọi chăm sóc khách: hệ thống tự tạo theo mốc (đăng kiểm, bảo hiểm, bảo dưỡng, hỏi thăm sau sửa) hoặc tạo tay
model CareTask {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  branchId    String?      @map("branch_id") @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  vehicleId   String?      @map("vehicle_id") @db.Uuid
  orderId     String?      @map("order_id") @db.Uuid
  kind        CareKind
  /// Chống tạo trùng khi quét lại (VD: DANG_KIEM:<xe>:2027-01-15)
  refKey      String       @map("ref_key")
  title       String
  /// Ngày cần gọi
  dueDate     DateTime     @map("due_date") @db.Date
  /// Mốc gốc (ngày hết hạn đăng kiểm, ngày giao xe…)
  eventDate   DateTime?    @map("event_date") @db.Date
  status      CareStatus   @default(CAN_GOI)
  attempts    Int          @default(0)
  lastOutcome CallOutcome? @map("last_outcome")
  doneAt      DateTime?    @map("done_at")
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  customer Customer  @relation(fields: [customerId], references: [id])
  calls    CallLog[]

  @@unique([tenantId, refKey])
  @@index([tenantId, status, dueDate])
  @@index([customerId])
  @@map("care_tasks")
}

model CallLog {
  id        String      @id @default(uuid()) @db.Uuid
  taskId    String      @map("task_id") @db.Uuid
  outcome   CallOutcome
  note      String?
  /// Hẹn gọi lại
  nextAt    DateTime?   @map("next_at") @db.Date
  bookingId String?     @map("booking_id") @db.Uuid
  actorId   String?     @map("actor_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")

  task CareTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("call_logs")
}

// ---------------- Vòng 1.5c · Thu chi & công nợ ----------------

enum CashType {
  THU
  CHI
}

/// Phiếu thu / chi ngoài đơn hàng (tiền thu theo đơn nằm ở bảng payments). Ghi nhầm thì huỷ phiếu, không xoá.
model CashEntry {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  branchId     String        @map("branch_id") @db.Uuid
  /// PT000001 (thu) · PCH000001 (chi)
  code         String
  type         CashType
  /// Khoản mục: THU_NO_DAU_KY, THU_KHAC, CHI_NHA_CUNG_CAP, LUONG, DIEN_NUOC, MAT_BANG, CONG_CU, CHI_KHAC…
  category     String
  amount       BigInt
  method       PaymentMethod
  /// Người nộp / người nhận (ghi tay)
  counterparty String?
  customerId   String?       @map("customer_id") @db.Uuid
  supplierId   String?       @map("supplier_id") @db.Uuid
  note         String?
  occurredAt   DateTime      @default(now()) @map("occurred_at")
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  voidedAt     DateTime?     @map("voided_at")
  voidedBy     String?       @map("voided_by") @db.Uuid
  voidReason   String?       @map("void_reason")

  @@unique([tenantId, code])
  @@index([tenantId, branchId, occurredAt])
  @@index([customerId])
  @@map("cash_entries")
}

// ---------------- Vòng 1.5e · App kỹ thuật viên ----------------

/// Phiếu kiểm tra xe điện tử: mỗi đơn một phiếu, KTV nhập trên điện thoại; bản in A4 lấy dữ liệu từ đây
model Inspection {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  /// InspectionData (@cardiy/shared): lốp, gạt mưa, an toàn, gầm, khuyến nghị, kiểm tra cuối
  data        Json      @default("{}")
  /// KTV kiểm tra (membership id)
  inspectorId String?   @map("inspector_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("inspections")
}

// ---------------- Vòng 2.1 · App chủ xe ----------------

/// Tài khoản (users) của chủ xe ↔ hồ sơ khách ở một garage. Một hồ sơ khách chỉ gắn một tài khoản; một tài khoản có thể là khách của nhiều garage.
model CustomerLink {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([userId])
  @@map("customer_links")
}

/// Lời mời dùng app: garage gửi link / QR cho khách; khách mở link để kích hoạt tài khoản. Token chỉ lưu dạng băm, dùng một lần.
model CustomerInvite {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_invites")
}

/// Phiên đăng nhập app chủ xe (tách khỏi phiên nhân viên: cookie riêng, token loại "owner")
model OwnerSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  rotatedAt DateTime? @map("rotated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("owner_sessions")
}

// ---------------- Vòng 2.2 · Khách duyệt báo giá trên app ----------------

enum QuoteStatus {
  CHO_DUYET
  DA_DUYET
  DUYET_MOT_PHAN
  TU_CHOI
  /// Hết hiệu lực: nhân viên sửa hạng mục / gửi báo giá mới / đơn không còn sửa được
  HET_HIEU_LUC
}

/// Báo giá gửi khách duyệt: chụp lại hạng mục lúc gửi; khách đồng ý / từ chối từng dòng trên app
model OrderQuote {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  status       QuoteStatus @default(CHO_DUYET)
  /// [{itemId, kind, name, unit, quantity, unitPrice, discount, amount, vatRate}]
  items        Json
  total        BigInt
  message      String?
  sentBy       String?     @map("sent_by") @db.Uuid
  sentAt       DateTime    @default(now()) @map("sent_at")
  /// itemId khách đồng ý
  approvedIds  String[]    @default([]) @map("approved_ids") @db.Uuid
  customerNote String?     @map("customer_note")
  respondedAt  DateTime?   @map("responded_at")
  /// Đã bỏ các dòng khách từ chối khỏi đơn chưa (không bỏ được khi tổng mới nhỏ hơn số đã thu)
  applied      Boolean     @default(false)

  order RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, sentAt])
  @@index([tenantId, status])
  @@map("order_quotes")
}

// ---------------- Vòng 2.3 · Zalo ZNS, OTP, đánh giá ----------------

/// Token Zalo OA của garage (mã hoá AES-GCM). Refresh token dùng một lần: mỗi lần làm mới lưu lại token mới
model ZaloToken {
  tenantId        String    @id @map("tenant_id") @db.Uuid
  /// Ứng dụng Zalo nhập trong CRM (Cài đặt → Zalo); trống thì dùng ZALO_APP_ID / ZALO_APP_SECRET của máy chủ
  appId           String?   @map("app_id")
  appSecretEnc    String?   @map("app_secret_enc")
  refreshTokenEnc String?   @map("refresh_token_enc")
  accessTokenEnc  String?   @map("access_token_enc")
  accessExpiresAt DateTime? @map("access_expires_at")
  lastError       String?   @map("last_error")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("zalo_tokens")
}

/// Nhật ký tin ZNS đã gửi / lỗi (đối soát chi phí, xem lỗi mẫu tin)
model ZaloMessage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  event      String
  phone      String
  templateId String   @map("template_id")
  status     String
  error      String?
  msgId      String?  @map("msg_id")
  refId      String?  @map("ref_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([refId])
  @@map("zalo_messages")
}

/// Khách đánh giá đơn sau khi nhận xe (1–5 sao); garage trả lời
model OrderReview {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  orderId    String    @unique @map("order_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  rating     Int
  comment    String?
  reply      String?
  repliedBy  String?   @map("replied_by") @db.Uuid
  repliedAt  DateTime? @map("replied_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  order RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("order_reviews")
}

// ---------------- Vòng 3.1 · Đăng ký đối tác, gói, phí đối tác (sàn) ----------------

/// Gói đối tác: giá theo tháng, thu theo kỳ (1/3/6/12 tháng). Bảng giá do sàn cấu hình
model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  monthlyFee    BigInt   @map("monthly_fee")
  billingMonths Int      @default(1) @map("billing_months")
  description   String?
  /// Quyền lợi hiển thị trên trang đăng ký (mỗi dòng một ý)
  features      String[] @default([])
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  applications  PartnerApplication[]
  subscriptions Subscription[]

  @@map("plans")
}

enum ApplicationStatus {
  CHO_DUYET
  CAN_BO_SUNG
  TU_CHOI
  DA_DUYET
}

/// Hồ sơ đăng ký làm đối tác (nộp trên trang công khai; Admin sàn duyệt)
model PartnerApplication {
  id             String            @id @default(uuid()) @db.Uuid
  /// HS000001
  code           String            @unique
  status         ApplicationStatus @default(CHO_DUYET)
  garageName     String            @map("garage_name")
  taxCode        String?           @map("tax_code")
  address        String
  province       String?
  representative String
  phone          String
  email          String?
  planId         String?           @map("plan_id") @db.Uuid
  note           String?
  /// [{fileId, kind: GPKD|CCCD|ANH|KHAC, name}]
  documents      Json              @default("[]")
  /// Băm token trong link theo dõi hồ sơ gửi cho người nộp
  accessHash     String            @map("access_hash")
  reviewNote     String?           @map("review_note")
  reviewedBy     String?           @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?         @map("reviewed_at")
  /// Tenant đối tác tạo ra khi duyệt
  tenantId       String?           @unique @map("tenant_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  plan Plan? @relation(fields: [planId], references: [id])

  @@index([status, createdAt])
  @@map("partner_applications")
}

/// Gói đối tác đang dùng (chụp giá lúc đăng ký)
model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  monthlyFee    BigInt    @map("monthly_fee")
  billingMonths Int       @map("billing_months")
  startAt       DateTime  @map("start_at") @db.Date
  /// Đã lập hoá đơn tới ngày này (kỳ tiếp theo bắt đầu từ đây)
  paidThrough   DateTime  @map("paid_through") @db.Date
  endedAt       DateTime? @map("ended_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  plan     Plan              @relation(fields: [planId], references: [id])
  invoices PlatformInvoice[]

  @@index([tenantId])
  @@map("subscriptions")
}

enum PlatformInvoiceStatus {
  DA_PHAT_HANH
  DA_THANH_TOAN
  HUY
}

/// Hoá đơn phí đối tác (sàn thu của đối tác). Quá hạn = chưa thanh toán và quá hạn thanh toán
model PlatformInvoice {
  id             String                @id @default(uuid()) @db.Uuid
  /// PHI000001
  code           String                @unique
  tenantId       String                @map("tenant_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  periodFrom     DateTime              @map("period_from") @db.Date
  periodTo       DateTime              @map("period_to") @db.Date
  amount         BigInt
  dueDate        DateTime              @map("due_date") @db.Date
  status         PlatformInvoiceStatus @default(DA_PHAT_HANH)
  paidAt         DateTime?             @map("paid_at")
  paidMethod     String?               @map("paid_method")
  paidNote       String?               @map("paid_note")
  recordedBy     String?               @map("recorded_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, periodFrom])
  @@index([status, dueDate])
  @@map("platform_invoices")
}

// ======================= Vòng 3.2: Danh mục chuẩn, gian hàng, tin đăng (D3) =======================

enum CatalogKind {
  PRODUCT
  SERVICE
}

/// Nhóm danh mục chuẩn của sàn (dùng chung mọi garage)
model CatalogCategory {
  id        String      @id @default(uuid()) @db.Uuid
  kind      CatalogKind
  parentId  String?     @map("parent_id") @db.Uuid
  name      String
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")

  parent   CatalogCategory?  @relation("CatalogTree", fields: [parentId], references: [id])
  children CatalogCategory[] @relation("CatalogTree")
  items    CatalogItem[]

  @@index([kind, parentId])
  @@map("catalog_categories")
}

/// Sản phẩm chuẩn (SKU) hoặc dịch vụ chuẩn của sàn. Tin đăng của garage phải chọn từ đây
model CatalogItem {
  id          String      @id @default(uuid()) @db.Uuid
  kind        CatalogKind
  /// SKU / mã dịch vụ chuẩn
  code        String      @unique
  name        String
  categoryId  String?     @map("category_id") @db.Uuid
  brand       String?
  unit        String?
  /// Thông số: [{label, value}] (kích cỡ, chỉ số tải, độ nhớt, dung lượng…)
  specs       Json        @default("[]")
  description String?
  imageFileId String?     @map("image_file_id") @db.Uuid
  /// Ẩn: không chọn được khi đăng tin mới, tin cũ vẫn giữ
  active      Boolean     @default(true)
  searchText  String      @default("") @map("search_text")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  category CatalogCategory? @relation(fields: [categoryId], references: [id])
  offers   Offer[]

  @@index([kind, categoryId])
  @@map("catalog_items")
}

enum CatalogProposalStatus {
  CHO_XU_LY
  DA_TAO
  TU_CHOI
}

/// Garage đề xuất thêm vào danh mục chuẩn khi không tìm thấy SKU / dịch vụ (A6.24)
model CatalogProposal {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  kind          CatalogKind
  name          String
  brand         String?
  note          String?
  status        CatalogProposalStatus @default(CHO_XU_LY)
  catalogItemId String?               @map("catalog_item_id") @db.Uuid
  reviewNote    String?               @map("review_note")
  createdBy     String                @map("created_by") @db.Uuid
  reviewedBy    String?               @map("reviewed_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")
  reviewedAt    DateTime?             @map("reviewed_at")

  @@index([status, createdAt])
  @@map("catalog_proposals")
}

/// Hồ sơ gian hàng trên sàn (mỗi garage / đối tác một gian hàng)
model Shop {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  /// Đường dẫn gian hàng: cardiy.vn/garage/<slug>
  slug           String   @unique
  name           String
  intro          String?
  phone          String?
  address        String?
  province       String?
  lat            Float?
  lng            Float?
  /// [{day: 0..6 (CN..T7), open: "07:30", close: "17:30", closed: bool}]
  openingHours   Json     @default("[]") @map("opening_hours")
  returnPolicy   String?  @map("return_policy")
  warrantyPolicy String?  @map("warranty_policy")
  cancelPolicy   String?  @map("cancel_policy")
  logoFileId     String?  @map("logo_file_id") @db.Uuid
  coverFileId    String?  @map("cover_file_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("shops")
}

/// S5: tin đăng. Hết hàng tính khi đọc (tồn khả dụng = 0), không lưu trạng thái riêng
enum OfferStatus {
  NHAP
  CHO_DUYET
  DANG_BAN
  BI_TU_CHOI
  TAM_AN
  BI_GO
}

/// Tin đăng sản phẩm / dịch vụ của garage trên sàn
model Offer {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  kind            CatalogKind
  catalogItemId   String      @map("catalog_item_id") @db.Uuid
  /// PLG: hàng trong kho CRM, tồn khả dụng = tổng tồn các chi nhánh bán. Đối tác: trống, nhập tồn tay
  productId       String?     @map("product_id") @db.Uuid
  /// Đối tác nhập tay số lượng còn bán
  manualStock     Int?        @map("manual_stock")
  /// Chi nhánh bán / làm dịch vụ (rỗng = mọi chi nhánh)
  branchIds       String[]    @default([]) @map("branch_ids") @db.Uuid
  price           BigInt
  /// Giá niêm yết (gạch ngang) nếu đang giảm
  listPrice       BigInt?     @map("list_price")
  /// Dịch vụ: giá là "từ" (tuỳ xe)
  priceFrom       Boolean     @default(false) @map("price_from")
  installIncluded Boolean     @default(false) @map("install_included")
  mfgYear         Int?        @map("mfg_year")
  /// Dịch vụ: thời gian làm dự kiến (phút)
  durationMinutes Int?        @map("duration_minutes")
  note            String?
  imageFileIds    String[]    @default([]) @map("image_file_ids") @db.Uuid
  status          OfferStatus @default(NHAP)
  reviewNote      String?     @map("review_note")
  reviewedBy      String?     @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?   @map("reviewed_at")
  submittedAt     DateTime?   @map("submitted_at")
  createdBy       String?     @map("created_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id])

  @@index([tenantId, kind, status])
  @@index([status, submittedAt])
  @@index([catalogItemId, status])
  @@map("offers")
}

// ======================= Vòng 3.4: Yêu cầu đặt hàng từ sàn, voucher (D4) =======================

/// S3 (rút gọn): garage xác nhận rồi đánh dấu hoàn tất khi khách đến lắp / nhận và đã thu tiền
enum OrderRequestStatus {
  CHO_XAC_NHAN
  DA_XAC_NHAN
  HOAN_THANH
  TU_CHOI
  HET_HAN
  KHACH_HUY
  KHONG_DEN
}

enum VoucherKind {
  PERCENT
  AMOUNT
}

/// Voucher của garage (garage tự phát hành, tự chịu; sàn chỉ hiển thị)
model Voucher {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  code        String
  title       String
  kind        VoucherKind
  /// PERCENT: 1–100 (%); AMOUNT: số tiền giảm
  value       Int
  minOrder    BigInt      @default(0) @map("min_order")
  /// Giảm tối đa (chỉ với PERCENT)
  maxDiscount BigInt?     @map("max_discount")
  /// ALL | PRODUCT | SERVICE
  appliesTo   String      @default("ALL") @map("applies_to")
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  /// Tổng lượt dùng tối đa (trống = không giới hạn)
  usageLimit  Int?        @map("usage_limit")
  active      Boolean     @default(true)
  createdBy   String?     @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  requests OrderRequest[]

  @@unique([tenantId, code])
  @@map("vouchers")
}

/// Yêu cầu đặt hàng / đặt lịch của khách trên sàn gửi tới một garage. Tiền không đi qua sàn
model OrderRequest {
  id             String             @id @default(uuid()) @db.Uuid
  /// YC000001 (đếm theo garage nhận)
  code           String
  tenantId       String             @map("tenant_id") @db.Uuid
  status         OrderRequestStatus @default(CHO_XAC_NHAN)
  customerName   String             @map("customer_name")
  phone          String
  plateNo        String?            @map("plate_no")
  note           String?
  /// Giờ hẹn lắp / làm dịch vụ / nhận hàng
  scheduledAt    DateTime           @map("scheduled_at")
  voucherId      String?            @map("voucher_id") @db.Uuid
  voucherCode    String?            @map("voucher_code")
  subtotal       BigInt
  discount       BigInt             @default(0)
  /// Tạm tính = subtotal − discount; garage chốt giá cuối khi xác nhận
  estimatedTotal BigInt             @map("estimated_total")
  finalTotal     BigInt?            @map("final_total")
  /// Ghi chú / lý do của garage (khách thấy)
  sellerNote     String?            @map("seller_note")
  accessHash     String             @map("access_hash")
  /// Hết hạn chờ xác nhận (24 giờ): tự nhả tồn
  expiresAt      DateTime           @map("expires_at")
  confirmedAt    DateTime?          @map("confirmed_at")
  closedAt       DateTime?          @map("closed_at")
  handledBy      String?            @map("handled_by") @db.Uuid
  ip             String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  voucher Voucher?           @relation(fields: [voucherId], references: [id])
  items   OrderRequestItem[]
  review  MarketReview?
  reports MarketReport[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([phone, status])
  @@index([status, expiresAt])
  @@map("order_requests")
}

model OrderRequestItem {
  id              String      @id @default(uuid()) @db.Uuid
  requestId       String      @map("request_id") @db.Uuid
  offerId         String      @map("offer_id") @db.Uuid
  kind            CatalogKind
  name            String
  quantity        Int
  unitPrice       BigInt      @map("unit_price")
  installIncluded Boolean     @default(false) @map("install_included")
  mfgYear         Int?        @map("mfg_year")

  request OrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([requestId])
  @@map("order_request_items")
}

// ======================= Vòng 3.5: Đánh giá, phản ánh & vi phạm, thống kê gian hàng (M27, D4) =======================

enum MarketReviewStatus {
  HIEN
  AN
}

/// Khách đánh giá sau khi yêu cầu đặt hàng / đặt lịch qua sàn hoàn tất (1 yêu cầu tối đa 1 đánh giá)
model MarketReview {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  requestId      String             @unique @map("request_id") @db.Uuid
  customerName   String             @map("customer_name")
  rating         Int
  comment        String?
  reply          String?
  repliedBy      String?            @map("replied_by") @db.Uuid
  repliedAt      DateTime?          @map("replied_at")
  status         MarketReviewStatus @default(HIEN)
  /// Garage báo cáo đánh giá sai sự thật / xúc phạm lên sàn (A6.33)
  reportedReason String?            @map("reported_reason")
  reportedBy     String?            @map("reported_by") @db.Uuid
  reportedAt     DateTime?          @map("reported_at")
  moderatedBy    String?            @map("moderated_by") @db.Uuid
  moderatedAt    DateTime?          @map("moderated_at")
  moderationNote String?            @map("moderation_note")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  request OrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([reportedAt])
  @@map("market_reviews")
}

enum MarketReportReason {
  SAI_GIA
  HANG_KHONG_DUNG
  THAI_DO_PHUC_VU
  KHONG_LIEN_LAC_DUOC
  BAO_HANH_DOI_TRA
  THONG_TIN_SAI
  KHAC
}

enum MarketReportStatus {
  MOI
  CHO_GIAI_TRINH
  DA_GIAI_TRINH
  DA_XU_LY
  TU_CHOI
}

/// Phản ánh của khách gửi tới sàn (từ link theo dõi yêu cầu hoặc từ trang gian hàng). Không làm đổi trạng thái yêu cầu (S3)
model MarketReport {
  id                String             @id @default(uuid()) @db.Uuid
  /// PA000001… (đếm theo tenant sàn)
  code              String             @unique
  tenantId          String             @map("tenant_id") @db.Uuid
  requestId         String?            @map("request_id") @db.Uuid
  offerId           String?            @map("offer_id") @db.Uuid
  reporterName      String             @map("reporter_name")
  reporterPhone     String             @map("reporter_phone")
  reason            MarketReportReason
  description       String
  status            MarketReportStatus @default(MOI)
  /// Nội dung sàn yêu cầu garage giải trình
  adminNote         String?            @map("admin_note")
  /// Giải trình của garage / đối tác
  sellerExplanation String?            @map("seller_explanation")
  explainedBy       String?            @map("explained_by") @db.Uuid
  explainedAt       DateTime?          @map("explained_at")
  /// Kết luận xử lý của sàn (khách & garage thấy)
  resolution        String?
  handledBy         String?            @map("handled_by") @db.Uuid
  resolvedAt        DateTime?          @map("resolved_at")
  ip                String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  request    OrderRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  violations ShopViolation[]

  @@index([status, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([requestId])
  @@index([reporterPhone, status])
  @@map("market_reports")
}

enum ViolationAction {
  NHAC_NHO
  GO_TIN
  TAM_KHOA
  CHAM_DUT
}

/// Quyết định xử lý vi phạm gian hàng / đối tác của sàn (A6.42)
model ShopViolation {
  id        String          @id @default(uuid()) @db.Uuid
  /// VP000001… (đếm theo tenant sàn)
  code      String          @unique
  tenantId  String          @map("tenant_id") @db.Uuid
  reportId  String?         @map("report_id") @db.Uuid
  offerId   String?         @map("offer_id") @db.Uuid
  action    ViolationAction
  reason    String
  createdBy String          @map("created_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")

  report MarketReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("shop_violations")
}

/// Lượt xem gian hàng (targetKey = "SHOP") và từng tin đăng (targetKey = offerId) cộng dồn theo ngày giờ VN (A7.30, A3.57)
model ShopDailyView {
  tenantId  String   @map("tenant_id") @db.Uuid
  viewDate  DateTime @map("view_date") @db.Date
  targetKey String   @map("target_key")
  offerId   String?  @map("offer_id") @db.Uuid
  views     Int      @default(0)

  @@id([tenantId, viewDate, targetKey])
  @@index([tenantId, viewDate])
  @@map("shop_daily_views")
}

// ======================= Vòng 4.1: Cứu hộ SOS (M33, F5, S6, D5) =======================

/// Máy trạng thái S6 (docs/05-trang-thai.md)
enum SosStatus {
  MOI
  DANG_TIM_GARAGE
  DA_NHAN
  KHONG_CO_GARAGE
  DANG_DEN
  TAI_HIEN_TRUONG
  XU_LY_TAI_CHO
  DANG_KEO_XE
  DA_VE_GARAGE
  HOAN_THANH
  KHACH_HUY
}

enum SosIssueType {
  HET_BINH
  THUNG_LOP
  CHET_MAY
  TAI_NAN
  HET_NHIEN_LIEU
  KEO_XE
  KHAC
}

/// Cấu hình dịch vụ cứu hộ của garage (đối tác hoặc PLG)
model SosConfig {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  enabled   Boolean  @default(false)
  /// Đang trực nhận ca cứu hộ ngay lúc này
  onDuty    Boolean  @default(true) @map("on_duty")
  hotline   String?
  radiusKm  Int      @default(30) @map("radius_km")
  basePrice BigInt   @default(0) @map("base_price")
  /// Chi nhánh trực mặc định (cho garage PLG khi tạo lệnh sửa chữa kéo xe về xưởng)
  branchId  String?  @map("branch_id") @db.Uuid
  note      String?
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sos_configs")
}

/// Yêu cầu cứu hộ SOS: sàn kết nối tới garage có dịch vụ cứu hộ gần nhất, khách trả tiền trực tiếp cho garage
model SosRequest {
  id                 String       @id @default(uuid()) @db.Uuid
  /// SOS000001… (đếm theo tenant sàn)
  code               String       @unique
  status             SosStatus    @default(MOI)
  userId             String?      @map("user_id") @db.Uuid
  vehicleId          String?      @map("vehicle_id") @db.Uuid
  customerName       String       @map("customer_name")
  phone              String
  plateNo            String?      @map("plate_no")
  vehicleInfo        String?      @map("vehicle_info")
  lat                Float
  lng                Float
  addressText        String?      @map("address_text")
  issueType          SosIssueType @map("issue_type")
  description        String?
  customerImageIds   String[]     @default([]) @map("customer_image_ids") @db.Uuid
  sceneImageIds      String[]     @default([]) @map("scene_image_ids") @db.Uuid
  /// Các garage đang trực trong bán kính được thông báo lúc gửi yêu cầu
  candidateTenantIds String[]     @default([]) @map("candidate_tenant_ids") @db.Uuid
  assignedTenantId   String?      @map("assigned_tenant_id") @db.Uuid
  assignedBranchId   String?      @map("assigned_branch_id") @db.Uuid
  /// Nhân viên đội cứu hộ được điều (membership id tại garage PLG)
  assignedStaffId    String?      @map("assigned_staff_id") @db.Uuid
  etaMinutes         Int?         @map("eta_minutes")
  quotedPrice        BigInt?      @map("quoted_price")
  finalPrice         BigInt?      @map("final_price")
  sellerNote         String?      @map("seller_note")
  cancelReason       String?      @map("cancel_reason")
  /// Lệnh sửa chữa tạo tại garage PLG khi kéo xe về xưởng (DANG_KEO_XE -> DA_VE_GARAGE)
  orderId            String?      @unique @map("order_id") @db.Uuid
  /// Băm mã bí mật cho link theo dõi công khai (/cho/cuu-ho/:id?t=...)
  accessHash         String       @map("access_hash")
  /// Hạn chờ garage nhận ca (3 phút từ lúc gửi); quá hạn tự chuyển KHONG_CO_GARAGE
  searchExpiresAt    DateTime     @map("search_expires_at")
  acceptedAt         DateTime?    @map("accepted_at")
  arrivedAt          DateTime?    @map("arrived_at")
  completedAt        DateTime?    @map("completed_at")
  cancelledAt        DateTime?    @map("cancelled_at")
  ip                 String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  tracks SosTrack[]
  review SosReview?

  @@index([status, searchExpiresAt])
  @@index([assignedTenantId, status, createdAt])
  @@index([userId, createdAt])
  @@index([phone, status])
  @@index([createdAt])
  @@map("sos_requests")
}

/// Lịch sử vị trí GPS của đội cứu hộ khi đang di chuyển (D5)
model SosTrack {
  id      BigInt   @id @default(autoincrement())
  sosId   String   @map("sos_id") @db.Uuid
  lat     Float
  lng     Float
  note    String?
  actorId String?  @map("actor_id") @db.Uuid
  at      DateTime @default(now())

  sos SosRequest @relation(fields: [sosId], references: [id], onDelete: Cascade)

  @@index([sosId, at])
  @@map("sos_tracks")
}

/// Khách đánh giá garage sau khi ca cứu hộ hoàn thành (1 ca tối đa 1 đánh giá)
model SosReview {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  sosId        String    @unique @map("sos_id") @db.Uuid
  customerName String    @map("customer_name")
  rating       Int
  comment      String?
  reply        String?
  repliedBy    String?   @map("replied_by") @db.Uuid
  repliedAt    DateTime? @map("replied_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sos SosRequest @relation(fields: [sosId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("sos_reviews")
}

// ======================= Vòng 4.2: Thuê xe (M31, F9, S8, D5) =======================

enum RentalOwnerType {
  GARAGE
  CONSIGN
}

/// Kiểm duyệt và hiển thị đội xe cho thuê trên sàn
enum RentalListingStatus {
  NHAP
  CHO_DUYET
  DANG_CHO_THUE
  BI_TU_CHOI
  TAM_AN
  BI_GO
}

/// Máy trạng thái S8: Hợp đồng thuê xe (docs/05-trang-thai.md)
enum RentalContractStatus {
  DAT_TRUOC
  DA_XAC_MINH
  DA_KY_COC
  DANG_THUE
  QUA_HAN
  DA_TRA_XE
  DA_QUYET_TOAN
  HUY
}

/// Xe cho thuê của garage (của chính garage hoặc xe ký gửi do garage quản lý)
model RentalVehicle {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  branchId      String?             @map("branch_id") @db.Uuid
  vehicleId     String?             @map("vehicle_id") @db.Uuid
  /// TX000001… theo garage
  code          String
  title         String
  plateNo       String              @map("plate_no")
  make          String
  model         String
  year          Int
