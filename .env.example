# Sao chép thành .env rồi sửa giá trị. Không commit file .env.

# PostgreSQL (docker compose up -d tạo sẵn user/mật khẩu/db = cardiy)
DATABASE_URL=postgresql://cardiy:cardiy@localhost:5432/cardiy?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Cổng chạy
API_PORT=4000
GARAGE_PORT=3000

# Web garage gọi API qua địa chỉ này
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cho phép web gọi API (nhiều địa chỉ cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:3000

# ---- Đăng nhập (vòng 0.2) ----
# Chuỗi bí mật ký token, tối thiểu 32 ký tự. Tạo mới: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-truoc-khi-chay-that-0123456789abcdef
# Bắt buộc 2FA cho Chủ garage / Quản lý / Admin sàn. Đặt false để demo nhanh trên máy.
AUTH_ENFORCE_2FA=false
# Địa chỉ công khai của API (tạo link xem file)
PUBLIC_API_URL=http://localhost:4000

# ---- Lưu file ----
# local: lưu thư mục FILE_LOCAL_DIR · s3: lưu MinIO / S3 (trên VPS)
FILE_STORAGE=local
FILE_LOCAL_DIR=./storage
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=cardiy
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Dữ liệu mẫu (tài khoản demo). Đặt false trên bản chính thức.
SEED_DEMO=true
