# Sao chép thành .env rồi sửa giá trị. Không commit file .env.

# PostgreSQL (docker compose up -d tạo sẵn user/mật khẩu/db = cardiy)
DATABASE_URL=postgresql://cardiy:cardiy@localhost:5432/cardiy?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Cổng chạy
API_PORT=4000
GARAGE_PORT=3000

# Web garage gọi API qua địa chỉ này
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cho phép web gọi API (nhiều địa chỉ cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:3000
